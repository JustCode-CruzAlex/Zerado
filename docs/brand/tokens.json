{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Zerado",
  "version": "1.0.0",
  "revision": "A",
  "owner": "FlowForgeSoft",
  "domain": "zerado.app",
  "colorScheme": "dark-native",
  "description": "Design tokens for Zerado, a terminal-first game-library tracker. Every text pair carries a measured WCAG 2.2 contrast ratio. Every brand colour carries a derived ANSI-256 index and a 16-colour fallback, because the product renders in a terminal.",

  "color": {
    "primitive": {
      "void":        { "value": "#05060A", "ansi256": 232, "ansi16": 0,  "note": "page ground; the screen when off" },
      "black900":    { "value": "#0B0D14", "ansi256": 232, "ansi16": 0,  "note": "default surface" },
      "black800":    { "value": "#141A24", "ansi256": 234, "ansi16": 0,  "note": "raised surface" },
      "black700":    { "value": "#1D2532", "ansi256": 235, "ansi16": 0,  "note": "overlay surface" },
      "black600":    { "value": "#2A3342", "ansi256": 236, "ansi16": 0,  "note": "decorative hairline only" },
      "slate500":    { "value": "#64748B", "ansi256": 67,  "ansi16": 8,  "note": "UI boundary; meets WCAG 1.4.11" },
      "chrome100":   { "value": "#E9EEF5", "ansi256": 255, "ansi16": 15 },
      "chrome300":   { "value": "#A9B5C7", "ansi256": 249, "ansi16": 7 },
      "chrome500":   { "value": "#8492A8", "ansi256": 67,  "ansi16": 8 },
      "steel":       { "value": "#A5A29B", "ansi256": 247, "ansi16": 7,  "note": "brushed stainless; warm-neutral by requirement, not taste" },
      "amber400":    { "value": "#FFC94D", "ansi256": 221, "ansi16": 11 },
      "amber500":    { "value": "#FFB000", "ansi256": 214, "ansi16": 11, "note": "primary brand colour; ANSI match is near-exact at dE 0.4" },
      "amber900":    { "value": "#8A5E00", "ansi256": 94,  "ansi16": 3 },
      "cyan300":     { "value": "#8CF0FF", "ansi256": 159, "ansi16": 14 },
      "cyan500":     { "value": "#19E0FF", "ansi256": 45,  "ansi16": 14, "note": "accent; rare by policy" },
      "cyan900":     { "value": "#0B6C7D", "ansi256": 23,  "ansi16": 6 },
      "scanner500":  { "value": "#FF2E2E", "ansi256": 9,   "ansi16": 9,  "note": "motion and alarm; never body text" },
      "scanner300":  { "value": "#FF6B6B", "ansi256": 203, "ansi16": 9,  "note": "text-safe error copy" },
      "scanner900":  { "value": "#5C1414", "ansi256": 52,  "ansi16": 1 },
      "orchid500":   { "value": "#C77DFF", "ansi256": 177, "ansi16": 13 },
      "orchid900":   { "value": "#4A2A63", "ansi256": 53,  "ansi16": 5 },
      "gridLine":    { "value": "#1A2740", "ansi256": 235, "ansi16": 0,  "note": "decorative; never carries meaning" }
    },

    "semantic": {
      "bg":              { "value": "#05060A" },
      "surface":         { "value": "#0B0D14" },
      "surfaceRaised":   { "value": "#141A24" },
      "surfaceOverlay":  { "value": "#1D2532" },
      "text":            { "value": "#E9EEF5", "contrastOnSurface": 16.65, "wcag": "AAA" },
      "textSecondary":   { "value": "#A9B5C7", "contrastOnSurface": 9.36,  "wcag": "AAA" },
      "textTertiary":    { "value": "#8492A8", "contrastOnSurface": 6.15,  "wcag": "AA", "worstCase": 4.89 },
      "textOnBrand":     { "value": "#05060A", "contrastOnAmber": 11.05, "contrastOnCyan": 12.68, "wcag": "AAA" },
      "textLink":        { "value": "#19E0FF", "contrastOnSurface": 12.15, "wcag": "AAA" },
      "primary":         { "value": "#FFB000", "contrastOnSurface": 10.59, "wcag": "AAA" },
      "primaryHover":    { "value": "#FFC94D", "contrastOnSurface": 12.68, "wcag": "AAA" },
      "primaryContrast": { "value": "#05060A" },
      "accent":          { "value": "#19E0FF", "contrastOnSurface": 12.15, "wcag": "AAA" },
      "accentContrast":  { "value": "#05060A" },
      "border":          { "value": "#2A3342", "contrastOnSurface": 1.53, "role": "decorative-only" },
      "borderStrong":    { "value": "#64748B", "contrastOnSurface": 4.08, "wcag": "AA-nontext", "worstCase": 3.24 },
      "focusRing":       { "value": "#19E0FF", "contrastOnSurface": 12.15 },
      "scanner":         { "value": "#FF2E2E", "role": "motion-and-alarm" },
      "scannerTrack":    { "value": "#5C1414" }
    },

    "state": {
      "_rule": "co-render: colour AND glyph AND label. Any one alone is insufficient. Minimum pairwise dE2000 across normal, protanopia and deuteranopia is 11.9.",
      "notStarted": { "color": "#A5A29B", "glyph": "○", "ascii": "[ ]", "label": "NOT STARTED", "ansi256": 247, "ansi16": "white",          "contrastOnSurface": 7.62 },
      "inProgress": { "color": "#FFB000", "glyph": "◐", "ascii": "[~]", "label": "IN PROGRESS", "ansi256": 214, "ansi16": "bright-yellow",  "contrastOnSurface": 10.59 },
      "zerado":     { "color": "#19E0FF", "glyph": "◉", "ascii": "[*]", "label": "ZERADO",      "ansi256": 45,  "ansi16": "bright-cyan",    "contrastOnSurface": 12.15 },
      "abandoned":  { "color": "#C77DFF", "glyph": "⊘", "ascii": "[x]", "label": "ABANDONED",   "ansi256": 177, "ansi16": "bright-magenta", "contrastOnSurface": 7.21 }
    },

    "paperBridge": {
      "_note": "Consumed by `flowforge docs pdf --brand-css` under these exact unprefixed names. Light by necessity: the brand-manual archetype hard-sets a white page in its print stylesheet, so a dark canvas would render pale ink on white paper. Hues stay within 10 degrees of the screen values.",
      "canvas":       { "value": "#F3F5F8" },
      "canvasWarm":   { "value": "#E6EAF0" },
      "surface":      { "value": "#FFFFFF" },
      "ink":          { "value": "#0B0D14", "contrastOnCanvas": 17.77, "wcag": "AAA" },
      "inkSoft":      { "value": "#39434F", "contrastOnCanvas": 9.20,  "wcag": "AAA" },
      "inkMuted":     { "value": "#5E6A7A", "contrastOnCanvas": 5.04,  "wcag": "AA" },
      "line":         { "value": "#C6D0DD", "role": "decorative-only" },
      "accent":       { "value": "#965600", "contrastOnCanvas": 5.30,  "wcag": "AA", "hueDeltaFromScreenAmber": 9.7 },
      "accentStrong": { "value": "#7A4600", "contrastOnCanvas": 7.11,  "wcag": "AAA" },
      "accentWash":   { "value": "#FDEFD6", "contrastInkOnWash": 17.09 },
      "sage":         { "value": "#0A6070", "contrastOnCanvas": 6.58,  "wcag": "AA", "hueDeltaFromScreenCyan": 3.1 }
    }
  },

  "typography": {
    "family": {
      "display": { "stack": "'Orbitron', 'Michroma', 'Arial Black', system-ui, sans-serif", "primary": "Orbitron", "license": "SIL Open Font License 1.1", "reservedFontName": "Orbitron", "designer": "Matt McInerney", "source": "https://github.com/googlefonts/orbitron-vf", "axes": { "wght": [400, 900] }, "role": "display-only; never below 23px, never for prose" },
      "body":    { "stack": "'Space Grotesk', 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif", "primary": "Space Grotesk", "license": "SIL Open Font License 1.1", "designer": "Florian Karsten", "source": "https://github.com/floriankarsten/space-grotesk", "axes": { "wght": [300, 700] }, "role": "the voice; all prose and UI" },
      "mono":    { "stack": "'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'DejaVu Sans Mono', monospace", "primary": "JetBrains Mono", "license": "SIL Open Font License 1.1", "designer": "Philipp Nurullin, Konstantin Bulenkov (JetBrains)", "source": "https://github.com/JetBrains/JetBrainsMono", "axes": { "wght": [100, 800] }, "role": "the product's native tongue; a first-class text role, not a code-block afterthought" }
    },
    "size": {
      "caption":      { "value": "0.8125rem", "px": 13, "lineHeight": 1.5,  "family": "body" },
      "sm":           { "value": "0.9375rem", "px": 15, "lineHeight": 1.6,  "family": "body" },
      "base":         { "value": "1.0625rem", "px": 17, "lineHeight": 1.65, "family": "body", "note": "floor for prose" },
      "lg":           { "value": "1.1875rem", "px": 19, "lineHeight": 1.6,  "family": "body" },
      "h3":           { "value": "1.4375rem", "px": 23, "lineHeight": 1.22, "family": "body",    "weight": 700 },
      "h2":           { "value": "2.125rem",  "px": 34, "lineHeight": 1.22, "family": "display", "weight": 600, "tracking": "0.02em", "case": "uppercase" },
      "h1":           { "value": "3.25rem",   "px": 52, "lineHeight": 1.08, "family": "display", "weight": 700, "tracking": "0.03em", "case": "uppercase" },
      "display":      { "value": "4.75rem",   "px": 76, "lineHeight": 1.02, "family": "display", "weight": 700, "tracking": "0.04em", "case": "uppercase" },
      "readout":      { "value": "0.8125rem", "px": 13, "lineHeight": 1.2,  "family": "mono",    "weight": 500, "tracking": "0.18em", "case": "uppercase", "note": "eyebrow and section labels" }
    },
    "displayFluid": "clamp(2.75rem, 1.35rem + 5.9vw, 4.75rem)",
    "h1Fluid":      "clamp(2.125rem, 1.35rem + 3.3vw, 3.25rem)",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 900 },
    "measure": "68ch"
  },

  "space": {
    "base": "4px",
    "scale": { "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem", "6": "2rem", "7": "3rem", "8": "4rem", "9": "6rem", "10": "8rem" },
    "gutter": "1.5rem",
    "sectionY": "6rem",
    "containerMax": "1180px",
    "containerNarrow": "760px"
  },

  "radius": { "none": "0", "sm": "2px", "md": "4px", "lg": "8px", "pill": "999px", "_note": "machined, not soft; the logo counter is the one generous curve and it belongs to the logo alone" },

  "motion": {
    "duration": { "instant": "90ms", "fast": "140ms", "base": "220ms", "slow": "380ms", "scanner": "2400ms" },
    "easing": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "out":      "cubic-bezier(0.16, 1, 0.3, 1)",
      "in":       "cubic-bezier(0.7, 0, 0.84, 0)",
      "scanner":  "cubic-bezier(0.45, 0, 0.55, 1)"
    },
    "scanner": {
      "cycle": "2400ms",
      "halfTravel": "1200ms",
      "direction": "alternate",
      "iteration": "infinite",
      "pipWidth": "18%",
      "trackHeight": "2px",
      "easing": "cubic-bezier(0.45, 0, 0.55, 1)",
      "rationale": "KITT's scanner was a physically oscillating mirror. Sinusoidal ease-in-out reproduces it; linear reads mechanical and a bounce reads cartoonish.",
      "reducedMotion": "pip parks at track centre at full opacity; travel stops; the element is never hidden"
    }
  },

  "effect": {
    "glowAmber": "0 0 0 1px rgb(255 176 0 / 0.28), 0 0 18px -2px rgb(255 176 0 / 0.38)",
    "glowCyan":  "0 0 0 1px rgb(25 224 255 / 0.30), 0 0 22px -2px rgb(25 224 255 / 0.42)",
    "glowRed":   "0 0 12px -1px rgb(255 46 46 / 0.60)",
    "elevation1": "0 1px 2px rgb(0 0 0 / 0.55)",
    "elevation2": "0 4px 14px -4px rgb(0 0 0 / 0.70)",
    "elevation3": "0 18px 48px -12px rgb(0 0 0 / 0.80)"
  },

  "accessibility": {
    "standard": "WCAG 2.2 Level AA",
    "bodyTextMinimum": 4.5,
    "largeTextAndUiMinimum": 3.0,
    "worstTextPairInSystem": { "pair": "textTertiary #8492A8 on surfaceOverlay #1D2532", "ratio": 4.89, "verdict": "PASS" },
    "cvdMethod": "Vienot, Brettel & Mollon (1999) dichromat simulation in linear RGB; separation measured as CIEDE2000",
    "cvdWorstPair": { "pair": "zerado x abandoned under deuteranopia", "deltaE": 11.9, "verdict": "distinct; glyph and label carry the remainder" },
    "noColor": "NO_COLOR strips all SGR sequences. Every state remains readable through its glyph and its label; nothing in the product encodes meaning in colour alone.",
    "reducedMotion": "all durations collapse to 1ms; the scanner pip parks rather than hides",
    "forcedColors": "surrenders colour to the OS; glyph and label carry state"
  }
}
