  {
   "id": "t1134530484",
   "type": "text",
   "x": 560.0,
   "y": 1000.0,
   "width": 430.0,
   "height": 240.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "price_quote          CACHE  (Phase 3)\nPK (item_id, shop, currency)\nUPSERT in place, never appended\ncurrent_cents \u00b7 low_cents \u00b7 low_at \u00b7 url\nobserved_at  NOT NULL\nNO history table, so no retention\nrule to forget. NO affiliate_url\ncolumn - its absence IS the rule.",
   "originalText": "price_quote          CACHE  (Phase 3)\nPK (item_id, shop, currency)\nUPSERT in place, never appended\ncurrent_cents \u00b7 low_cents \u00b7 low_at \u00b7 url\nobserved_at  NOT NULL\nNO history table, so no retention\nrule to forget. NO affiliate_url\ncolumn - its absence IS the rule.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
