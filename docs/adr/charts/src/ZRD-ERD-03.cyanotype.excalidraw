  {
   "id": "t1407348072",
   "type": "text",
   "x": 100.0,
   "y": 1422.0,
   "width": 1029.6,
   "height": 18.2,
   "strokeColor": "#FF8A8A",
   "backgroundColor": "transparent",
   "text": "A connection is a relationship the player can END; the library outlives it. An FK would force a choice between deleting a library on",
   "originalText": "A connection is a relationship the player can END; the library outlives it. An FK would force a choice between deleting a library on",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
