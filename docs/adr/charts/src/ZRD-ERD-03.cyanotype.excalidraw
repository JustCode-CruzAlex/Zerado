  {
   "id": "t678600641",
   "type": "text",
   "x": 860.0,
   "y": 210.0,
   "width": 560.0,
   "height": 340.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "item_user          TRUTH - only the player writes here\nitem_id            PK, FK item(id) ON DELETE CASCADE\nstatus_manual      TEXT NULL   NULL = derive on read\nstatus_changed_at  TEXT NULL   survives a CLEAR - Phase 4 LWW\nrating             INTEGER NULL   Phase 2 writes it\nnotes              TEXT NULL      Phase 2 writes it\n\n1:1, materialised by trigger. The sync's UPSERT\nCANNOT erase a status: the statement cannot\nname a column in this table.",
   "originalText": "item_user          TRUTH - only the player writes here\nitem_id            PK, FK item(id) ON DELETE CASCADE\nstatus_manual      TEXT NULL   NULL = derive on read\nstatus_changed_at  TEXT NULL   survives a CLEAR - Phase 4 LWW\nrating             INTEGER NULL   Phase 2 writes it\nnotes              TEXT NULL      Phase 2 writes it\n\n1:1, materialised by trigger. The sync's UPSERT\nCANNOT erase a status: the statement cannot\nname a column in this table.",
