  },
  {
   "id": "t18894308",
   "type": "text",
   "x": 100.0,
   "y": 1280.0,
   "width": 1138.8,
   "height": 18.2,
   "strokeColor": "#6EE7A0",
   "backgroundColor": "transparent",
   "text": "A sync writes item, and only item. It cannot destroy a status, a note or a rating, because the UPSERT statement cannot NAME a column in item_user.",
   "originalText": "A sync writes item, and only item. It cannot destroy a status, a note or a rating, because the UPSERT statement cannot NAME a column in item_user.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1960104525,
   "version": 1,
   "versionNonce": 1262432514,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t878881299",
   "type": "text",
   "x": 100.0,
   "y": 1308.0,
   "width": 1263.6,
   "height": 18.2,
   "strokeColor": "#6EE7A0",
   "backgroundColor": "transparent",
   "text": "A physical row needs no separate guard: physical implements Provider and NOT Syncer, so no sync statement ever reaches it. D1 is what makes this rule enforceable.",
   "originalText": "A physical row needs no separate guard: physical implements Provider and NOT Syncer, so no sync statement ever reaches it. D1 is what makes this rule enforceable.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 998663248,
   "version": 1,
   "versionNonce": 816399945,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t821254990",
   "type": "text",
   "x": 100.0,
   "y": 1336.0,
   "width": 1068.6,
   "height": 18.2,
   "strokeColor": "#6EE7A0",
   "backgroundColor": "transparent",
   "text": "Measured cost of the split: +9.8 us on the root screen's page query, +128 us on a whole cold open of 400 titles. Cold open total: 842 us.",
   "originalText": "Measured cost of the split: +9.8 us on the root screen's page query, +128 us on a whole cold open of 400 titles. Cold open total: 842 us.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
