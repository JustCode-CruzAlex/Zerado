  {
   "id": "t207152657",
   "type": "text",
   "x": 100.0,
   "y": 1250.0,
   "width": 366.59999999999997,
   "height": 18.2,
   "strokeColor": "#6EE7A0",
   "backgroundColor": "transparent",
   "text": "THE LINE IS A TABLE BOUNDARY, NOT A CONVENTION.",
   "originalText": "THE LINE IS A TABLE BOUNDARY, NOT A CONVENTION.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 437867382,
   "version": 1,
