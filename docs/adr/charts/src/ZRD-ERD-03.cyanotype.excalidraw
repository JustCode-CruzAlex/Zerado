  {
   "id": "t1374071996",
   "type": "text",
   "x": 100.0,
   "y": 210.0,
   "width": 700.0,
   "height": 640.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "item          IDENTITY + PROVIDER REPLICA\nid                     INTEGER PK\nitem_uid               TEXT NN     merge hint - indexed, NOT unique\nitem_type              TEXT NN     CHECK = 'game'  <- the whole door\nprovider_id            TEXT NN  }  UNIQUE - the upsert's conflict target\nprovider_ref           TEXT NN  }\nacquisition            TEXT NN     CHECK digital | physical\ntitle / sort_title / search_title  TEXT NN   two derived, two jobs\nplatform               TEXT NN\nplaytime_minutes       INTEGER NULL  NULL = source cannot know\nlast_played_at         TEXT NULL     NULL = not reported\nowned_since            TEXT NULL     YYYY | YYYY-MM | YYYY-MM-DD\nsteam_appid / achievements_total / _unlocked\nabsent_since           TEXT NULL     tombstone, NEVER a delete\nmerged_into            INTEGER NULL  FK item(id)\nlast_synced_at         TEXT NULL     PER ROW - a PARTIAL run leaves gaps\ncreated_at / updated_at  TEXT NN",
   "originalText": "item          IDENTITY + PROVIDER REPLICA\nid                     INTEGER PK\nitem_uid               TEXT NN     merge hint - indexed, NOT unique\nitem_type              TEXT NN     CHECK = 'game'  <- the whole door\nprovider_id            TEXT NN  }  UNIQUE - the upsert's conflict target\nprovider_ref           TEXT NN  }\nacquisition            TEXT NN     CHECK digital | physical\ntitle / sort_title / search_title  TEXT NN   two derived, two jobs\nplatform               TEXT NN\nplaytime_minutes       INTEGER NULL  NULL = source cannot know\nlast_played_at         TEXT NULL     NULL = not reported\nowned_since            TEXT NULL     YYYY | YYYY-MM | YYYY-MM-DD\nsteam_appid / achievements_total / _unlocked\nabsent_since           TEXT NULL     tombstone, NEVER a delete\nmerged_into            INTEGER NULL  FK item(id)\nlast_synced_at         TEXT NULL     PER ROW - a PARTIAL run leaves gaps\ncreated_at / updated_at  TEXT NN",
