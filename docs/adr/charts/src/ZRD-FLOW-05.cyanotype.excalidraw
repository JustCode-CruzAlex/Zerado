  {
   "id": "t1960104525",
   "type": "text",
   "x": 355.8,
   "y": 1178,
   "width": 360,
   "height": 18,
   "strokeColor": "#9DC4E6",
   "backgroundColor": "transparent",
   "text": "Interface segregation makes physical copies first-class by construction. A screen never talks to a provider; a provider never talks to a screen. Between them sits the Store.",
   "originalText": "Interface segregation makes physical copies first-class by construction. A screen never talks to a provider; a provider never talks to a screen. Between them sits the Store.",
