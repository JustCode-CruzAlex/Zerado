  {
   "id": "t83284895",
   "type": "text",
   "x": 100.0,
   "y": 970.0,
   "width": 1505.3999999999999,
   "height": 18.2,
   "strokeColor": "#8FD0FF",
   "backgroundColor": "transparent",
   "text": "A screen never talks to a provider. A provider never talks to a screen. Between them sits the Store \u2014 which is why the offline contract is STRUCTURAL rather than a feature that had to be added.",
   "originalText": "A screen never talks to a provider. A provider never talks to a screen. Between them sits the Store \u2014 which is why the offline contract is STRUCTURAL rather than a feature that had to be added.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1569504492,
   "version": 1,
   "versionNonce": 1090816181,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t1100188490",
   "type": "text",
   "x": 100.0,
   "y": 1030.0,
   "width": 1333.8,
   "height": 18.2,
   "strokeColor": "#6EE7A0",
   "backgroundColor": "transparent",
   "text": "Everything downstream reads Capabilities, never ProviderID. An is_physical boolean would force every new feature to remember a special case \u2014 and eventually one would not.",
   "originalText": "Everything downstream reads Capabilities, never ProviderID. An is_physical boolean would force every new feature to remember a special case \u2014 and eventually one would not.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
