  {
   "id": "t1960104525",
   "type": "text",
   "x": 90.0,
   "y": 1390.0,
   "width": 1536.6,
   "height": 18.2,
   "strokeColor": "#94A3B8",
   "backgroundColor": "transparent",
   "text": "KEY    violet = the item (sheet 01)    \u00b7    gold = Phase 2 enrichment, every row stamped with fetched_at / observed_at    \u00b7    blue = Phase 4 server side    \u00b7    red = the only payload that crosses",
   "originalText": "KEY    violet = the item (sheet 01)    \u00b7    gold = Phase 2 enrichment, every row stamped with fetched_at / observed_at    \u00b7    blue = Phase 4 server side    \u00b7    red = the only payload that crosses",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1262432514,
   "version": 1,
   "versionNonce": 878881299,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t998663248",
   "type": "text",
   "x": 90.0,
   "y": 1450.0,
   "width": 1591.2,
   "height": 18.2,
   "strokeColor": "#EF4444",
   "backgroundColor": "transparent",
   "text": "state_change, comment and review key off item_uid \u2014 a stable, content-derived identity assigned in Phase 1. It is a merge HINT, not authoritative: ambiguous matches are shown to the player, never guessed.",
   "originalText": "state_change, comment and review key off item_uid \u2014 a stable, content-derived identity assigned in Phase 1. It is a merge HINT, not authoritative: ambiguous matches are shown to the player, never guessed.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 816399945,
   "version": 1,
   "versionNonce": 821254990,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t1774441583",
   "type": "text",
   "x": 90.0,
   "y": 1510.0,
   "width": 1177.8,
   "height": 18.2,
   "strokeColor": "#EF4444",
   "backgroundColor": "transparent",
   "text": "NEVER crosses: the library itself, playtime, last_played_at, cover art, sinopse, prices \u2014 every one re-derivable on each device. And credentials. Ever.",
   "originalText": "NEVER crosses: the library itself, playtime, last_played_at, cover art, sinopse, prices \u2014 every one re-derivable on each device. And credentials. Ever.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 804615548,
   "version": 1,
   "versionNonce": 255262213,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t2024660570",
