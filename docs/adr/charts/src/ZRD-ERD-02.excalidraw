   "y": 178.0,
   "width": 405.59999999999997,
   "height": 18.2,
   "strokeColor": "#F59E0B",
   "backgroundColor": "transparent",
   "text": "PHASE 2 \u2014 ENRICHMENT   \u00b7   every row carries its age",
   "originalText": "PHASE 2 \u2014 ENRICHMENT   \u00b7   every row carries its age",
