  {
   "id": "t437867382",
   "type": "text",
   "x": 460.0,
   "y": 1140.0,
   "width": 980.0,
   "height": 80.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "OPEN  \u2014  the library is usable\nclean shutdown: wal_checkpoint(TRUNCATE), then close  ->  exactly one file",
