  {
   "id": "t1504216469",
   "type": "text",
   "x": 460.0,
   "y": 910.0,
   "width": 980.0,
   "height": 170.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "A MIGRATION FAILS MID-WAY\nThe transaction rolls back. The file is byte-identical to what it was.\nThe program REFUSES to run and names three things: the migration that failed,\nthe error, and the backup path if one was taken.\nThere is no half-applied version, because the bookkeeping INSERT is inside\nthe same transaction as the DDL it records.",
   "originalText": "A MIGRATION FAILS MID-WAY\nThe transaction rolls back. The file is byte-identical to what it was.\nThe program REFUSES to run and names three things: the migration that failed,\nthe error, and the backup path if one was taken.\nThere is no half-applied version, because the bookkeeping INSERT is inside\nthe same transaction as the DDL it records.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
