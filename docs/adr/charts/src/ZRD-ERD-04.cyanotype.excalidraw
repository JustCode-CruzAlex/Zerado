  {
   "id": "t1174608190",
   "type": "text",
   "x": 780.0,
   "y": 250.0,
   "width": 340.0,
   "height": 150.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "PRECONDITIONS\nsqlite_version() >= 3.37.0 ?\n  (STRICT tables)\nPRAGMA foreign_keys = ON\nPRAGMA journal_mode = WAL\nPRAGMA busy_timeout = 5000",
