  {
   "id": "t198007546",
   "type": "text",
   "x": 780.0,
   "y": 610.0,
   "width": 340.0,
   "height": 230.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "C \u00b7 BEHIND\nmax(version) < HEAD\n\n1. destructive step ahead?\n   VACUUM INTO\n   library.db.pre-<v>\n2. apply the gap, in order\n3. PRAGMA foreign_key_check\n4. COMMIT, per migration",
   "originalText": "C \u00b7 BEHIND\nmax(version) < HEAD\n\n1. destructive step ahead?\n   VACUUM INTO\n   library.db.pre-<v>\n2. apply the gap, in order\n3. PRAGMA foreign_key_check\n4. COMMIT, per migration",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
