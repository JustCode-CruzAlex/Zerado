  {
   "id": "t847246112",
   "type": "text",
   "x": 1540.0,
   "y": 610.0,
   "width": 300.0,
   "height": 230.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "E \u00b7 FOREIGN  \u2014  REFUSE\nno schema_migration table,\nbut the file is not empty.\n\nSome other program's SQLite\nfile, or a corrupted one.\nNever migrate a schema you\ndid not write.",
   "originalText": "E \u00b7 FOREIGN  \u2014  REFUSE\nno schema_migration table,\nbut the file is not empty.\n\nSome other program's SQLite\nfile, or a corrupted one.\nNever migrate a schema you\ndid not write.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
