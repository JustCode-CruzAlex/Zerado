  },
  {
   "id": "t1960104525",
   "type": "text",
   "x": 80.0,
   "y": 1280.0,
   "width": 858.0,
   "height": 18.2,
   "strokeColor": "#8FD0FF",
   "backgroundColor": "transparent",
   "text": "FORWARD-ONLY. There are no down migrations: a mistake is corrected by a NEW migration, never by reversing one.",
   "originalText": "FORWARD-ONLY. There are no down migrations: a mistake is corrected by a NEW migration, never by reversing one.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1262432514,
   "version": 1,
   "versionNonce": 878881299,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t998663248",
   "type": "text",
   "x": 80.0,
   "y": 1310.0,
   "width": 990.5999999999999,
   "height": 18.2,
   "strokeColor": "#8FD0FF",
   "backgroundColor": "transparent",
   "text": "A RELEASED MIGRATION IS IMMUTABLE. Editing 0001 after a release means two files claim version 1 and disagree about what it did.",
   "originalText": "A RELEASED MIGRATION IS IMMUTABLE. Editing 0001 after a release means two files claim version 1 and disagree about what it did.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 816399945,
   "version": 1,
   "versionNonce": 821254990,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t1774441583",
   "type": "text",
   "x": 80.0,
   "y": 1340.0,
   "width": 1029.6,
   "height": 18.2,
   "strokeColor": "#FF8A8A",
   "backgroundColor": "transparent",
   "text": "EVERY PATH ENDS SOMEWHERE NAMED. The program opens the file, or it refuses and says which version wrote it and which one is running.",
   "originalText": "EVERY PATH ENDS SOMEWHERE NAMED. The program opens the file, or it refuses and says which version wrote it and which one is running.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 804615548,
   "version": 1,
   "versionNonce": 255262213,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t2024660570",
   "type": "text",
   "x": 80.0,
   "y": 1370.0,
   "width": 826.8,
   "height": 18.2,
   "strokeColor": "#FF8A8A",
   "backgroundColor": "transparent",
   "text": "Silently proceeding against a schema you do not understand is how one file becomes two incompatible files.",
   "originalText": "Silently proceeding against a schema you do not understand is how one file becomes two incompatible files.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 795035787,
   "version": 1,
   "versionNonce": 1407348072,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
