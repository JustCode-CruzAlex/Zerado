   "height": 230.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "B \u00b7 EQUAL\nmax(version) == HEAD\n\nOpen it. Nothing to do.\nThe common path, and it\ncosts one page read.",
   "originalText": "B \u00b7 EQUAL\nmax(version) == HEAD\n\nOpen it. Nothing to do.\nThe common path, and it\ncosts one page read.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.3,
