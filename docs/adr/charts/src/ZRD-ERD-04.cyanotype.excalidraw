  {
   "id": "t1416205447",
   "type": "text",
   "x": 1160.0,
   "y": 610.0,
   "width": 340.0,
   "height": 230.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "D \u00b7 AHEAD  \u2014  REFUSE\nmax(version) > HEAD\n\nA newer binary wrote this file.\nZ-11 names BOTH versions:\n  the file's, from written_by\n  the running one\n\nThis is why written_by exists.",
   "originalText": "D \u00b7 AHEAD  \u2014  REFUSE\nmax(version) > HEAD\n\nA newer binary wrote this file.\nZ-11 names BOTH versions:\n  the file's, from written_by\n  the running one\n\nThis is why written_by exists.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
