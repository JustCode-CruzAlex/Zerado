  {
   "id": "t974590625",
   "type": "text",
   "x": 90.0,
   "y": 1260.0,
   "width": 1848.6,
   "height": 18.2,
   "strokeColor": "#6EE7A0",
   "backgroundColor": "transparent",
   "text": "BUNDLED, NEVER STREAMED. No CDN, no fetch, no cache warm \u2014 so audio makes no network requests at all. That is what keeps three ratified promises intact, and it is why audio is WORKS in the offline contract rather than an exception to it.",
   "originalText": "BUNDLED, NEVER STREAMED. No CDN, no fetch, no cache warm \u2014 so audio makes no network requests at all. That is what keeps three ratified promises intact, and it is why audio is WORKS in the offline contract rather than an exception to it.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 218508486,
   "version": 1,
   "versionNonce": 1416205447,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t1134530484",
   "type": "text",
   "x": 90.0,
   "y": 1315.0,
   "width": 1482.0,
   "height": 18.2,
   "strokeColor": "#8FD0FF",
   "backgroundColor": "transparent",
   "text": "The default BUILD contains NullAudio and stays pure Go, so the cross-compile matrix survives and the silent path is the one every test run exercises. The real player sits behind a build tag.",
   "originalText": "The default BUILD contains NullAudio and stays pure Go, so the cross-compile matrix survives and the silent path is the one every test run exercises. The real player sits behind a build tag.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
