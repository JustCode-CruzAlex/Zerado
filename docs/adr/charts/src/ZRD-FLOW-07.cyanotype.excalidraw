  {
   "id": "t620279647",
   "type": "text",
   "x": 349.8,
   "y": 1398,
   "width": 360,
   "height": 18,
   "strokeColor": "#9DC4E6",
   "backgroundColor": "transparent",
   "text": "Audio ships in Phase 1. It cannot fail, block or hang.",
   "originalText": "Audio ships in Phase 1. It cannot fail, block or hang.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
