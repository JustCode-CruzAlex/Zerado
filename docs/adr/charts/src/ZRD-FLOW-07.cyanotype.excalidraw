  {
   "id": "t1497096041",
   "type": "text",
   "x": 90.0,
   "y": 560.0,
   "width": 400.0,
   "height": 240.0,
   "strokeColor": "#EAF4FF",
   "backgroundColor": "transparent",
   "text": "OFF BY DEFAULT\nexplicit opt-in in Z-09\nnothing plays on first run\nso WCAG 1.4.2 is satisfied\nbefore its 3s threshold, not after",
