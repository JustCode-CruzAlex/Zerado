   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t83284895",
   "type": "text",
   "x": 110.0,
   "y": 1195.0,
   "width": 1146.6,
   "height": 18.2,
   "strokeColor": "#9DC4E6",
   "backgroundColor": "transparent",
   "text": "KEY    violet = the item    \u00b7    blue = sync bookkeeping    \u00b7    grey = local-only, never syncs    \u00b7    red = deliberately OUTSIDE the library file",
   "originalText": "KEY    violet = the item    \u00b7    blue = sync bookkeeping    \u00b7    grey = local-only, never syncs    \u00b7    red = deliberately OUTSIDE the library file",
   "fontSize": 13,
