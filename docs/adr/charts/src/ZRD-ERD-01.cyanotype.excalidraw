  {
   "id": "t264795901",
   "type": "text",
   "x": 110.0,
   "y": 830.0,
   "width": 2230.7999999999997,
   "height": 18.2,
   "strokeColor": "#6EE7A0",
   "backgroundColor": "transparent",
   "text": "THE DOOR-OPEN AFFORDANCE IS TWO DECISIONS: item_type exists and is CHECKed to 'game', and the table is not called games. Nothing else is generalised. Game facts live on the item; there is no typed extension and no generic progress, because there is no second type to separate them from.",
   "originalText": "THE DOOR-OPEN AFFORDANCE IS TWO DECISIONS: item_type exists and is CHECKed to 'game', and the table is not called games. Nothing else is generalised. Game facts live on the item; there is no typed extension and no generic progress, because there is no second type to separate them from.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 290058226,
   "version": 1,
   "versionNonce": 1791170115,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t548082880",
   "type": "text",
   "x": 110.0,
   "y": 1140.0,
   "width": 873.6,
   "height": 18.2,
   "strokeColor": "#8FD0FF",
   "backgroundColor": "transparent",
   "text": "effective_status is NOT stored. It is derived on read:  status_manual ?? derive(playtime_minutes, capabilities).",
   "originalText": "effective_status is NOT stored. It is derived on read:  status_manual ?? derive(playtime_minutes, capabilities).",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1437238777,
   "version": 1,
   "versionNonce": 1174608190,
   "isDeleted": false,
