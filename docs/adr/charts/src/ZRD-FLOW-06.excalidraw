  {
   "id": "t290058226",
   "type": "text",
   "x": 80.0,
   "y": 1270.0,
   "width": 1817.3999999999999,
   "height": 18.2,
   "strokeColor": "#94A3B8",
   "backgroundColor": "transparent",
   "text": "Zerado does NOT probe for connectivity. No heartbeat, no reachability check \u2014 that would be exactly the background traffic the page promises does not exist, and it is unreliable anyway. A request fails, and the failure is classified.",
   "originalText": "Zerado does NOT probe for connectivity. No heartbeat, no reachability check \u2014 that would be exactly the background traffic the page promises does not exist, and it is unreliable anyway. A request fails, and the failure is classified.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1791170115,
   "version": 1,
   "versionNonce": 548082880,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t1437238777",
   "type": "text",
   "x": 80.0,
   "y": 1330.0,
   "width": 1770.6,
   "height": 18.2,
   "strokeColor": "#EF4444",
   "backgroundColor": "transparent",
   "text": "Any value that came from the network is rendered with its age. ALWAYS.   \"$15\" is forbidden.   \"$15 \u00b7 3 days ago\" is required. Zerado's value is telling a player NOT to buy; a stale price shown as current is advice from memory.",
   "originalText": "Any value that came from the network is rendered with its age. ALWAYS.   \"$15\" is forbidden.   \"$15 \u00b7 3 days ago\" is required. Zerado's value is telling a player NOT to buy; a stale price shown as current is advice from memory.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
