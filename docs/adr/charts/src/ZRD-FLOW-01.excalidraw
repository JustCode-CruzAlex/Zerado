  {
   "id": "t1370097957",
   "type": "text",
   "x": 80.0,
   "y": 830.0,
   "width": 1645.8,
   "height": 18.2,
   "strokeColor": "#94A3B8",
   "backgroundColor": "transparent",
   "text": "The condition is checked ONCE, at start-up, and never re-checked. A player who deletes every game does not get thrown back into first run \u2014 that would be the program telling them they had undone their own setup.",
   "originalText": "The condition is checked ONCE, at start-up, and never re-checked. A player who deletes every game does not get thrown back into first run \u2014 that would be the program telling them they had undone their own setup.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
