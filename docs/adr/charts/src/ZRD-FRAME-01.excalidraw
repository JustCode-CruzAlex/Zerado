  {
   "id": "t1467657591",
   "type": "text",
   "x": 361.8,
   "y": 1358,
   "width": 360,
   "height": 18,
   "strokeColor": "#94A3B8",
   "backgroundColor": "transparent",
   "text": "The frame at 80x24, row by row, with every spacing token named. Body canvas is 74 x 16. Header-left equals content-left at column 4. Zerado carries no header subtitle on any screen, so the band is always the 3-row base.",
   "originalText": "The frame at 80x24, row by row, with every spacing token named. Body canvas is 74 x 16. Header-left equals content-left at column 4. Zerado carries no header subtitle on any screen, so the band is always the 3-row base.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
