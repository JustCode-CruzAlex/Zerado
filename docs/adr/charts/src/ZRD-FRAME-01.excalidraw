  {
   "id": "t290058226",
   "type": "text",
   "x": 1370.0,
   "y": 870.0,
   "width": 620.0,
   "height": 300.0,
   "strokeColor": "#FAFAFA",
   "backgroundColor": "transparent",
   "text": "WHY THE GLYPH FIELD IS 2 COLUMNS\n\u25cb U+25CB and \u25d0 U+25D0 are AMBIGUOUS width.\n\u25c9 U+25C9 and \u2298 U+2298 are Neutral.\nAmbiguous = 1 cell in most terminals, 2 where\nthe user set ambiguous-width=double. A 1-column\nbudget would shear the state column on a real\nclass of terminals \u2014 on the most-used component\nin the product. Fixed in RENDERING, never by\nchanging the ratified glyphs.",
   "originalText": "WHY THE GLYPH FIELD IS 2 COLUMNS\n\u25cb U+25CB and \u25d0 U+25D0 are AMBIGUOUS width.\n\u25c9 U+25C9 and \u2298 U+2298 are Neutral.\nAmbiguous = 1 cell in most terminals, 2 where\nthe user set ambiguous-width=double. A 1-column\nbudget would shear the state column on a real\nclass of terminals \u2014 on the most-used component\nin the product. Fixed in RENDERING, never by\nchanging the ratified glyphs.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
