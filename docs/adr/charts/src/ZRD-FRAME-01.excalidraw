  {
   "id": "t1437238777",
   "type": "text",
   "x": 140.0,
   "y": 1200.0,
   "width": 928.1999999999999,
   "height": 18.2,
   "strokeColor": "#9D7BFF",
   "backgroundColor": "transparent",
   "text": "BodyRect.h = 24 \u2212 HeaderBandHeight (3) \u2212 footer (1) \u2212 2\u00b7OuterMarginY (2) \u2212 InnerPaddingY (1) \u2212 InterElementGap (1) = 16",
   "originalText": "BodyRect.h = 24 \u2212 HeaderBandHeight (3) \u2212 footer (1) \u2212 2\u00b7OuterMarginY (2) \u2212 InnerPaddingY (1) \u2212 InterElementGap (1) = 16",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1174608190,
   "version": 1,
   "versionNonce": 83284895,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1717000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "t1569504492",
   "type": "text",
   "x": 140.0,
   "y": 1255.0,
   "width": 1770.6,
   "height": 18.2,
   "strokeColor": "#94A3B8",
   "backgroundColor": "transparent",
   "text": "80 \u00d7 24 is the design width and the guaranteed floor. Every screen is composed at 74 \u00d7 16 first and enhanced upward. A screen that only reads well at 120 columns is not finished; a screen that REQUIRES more than 80 is a defect.",
   "originalText": "80 \u00d7 24 is the design width and the guaranteed floor. Every screen is composed at 74 \u00d7 16 first and enhanced upward. A screen that only reads well at 120 columns is not finished; a screen that REQUIRES more than 80 is a defect.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.3,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "fillStyle": "solid",
   "roughness": 1,
