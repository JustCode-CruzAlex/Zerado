---
/**
 * Section 12 — roadmap, the customer's required section. Phase 1 renders
 * "In progress" (founder instruction, 2026-08-25, when Phase 1 work started);
 * phases 2-4 render "Planned". NONE is marked done. No dates render.
 * Ref: design/blueprint.md §2 (§12); content/landing-copy.md §12.
 */
import SectionEyebrow from '../components/SectionEyebrow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RoadmapTrack from '../components/RoadmapTrack.astro';
---

<section id="roadmap" aria-labelledby="roadmap-heading" class="z-section z-section--surface">
  <div class="z-container">
    <SectionEyebrow index={12} id="roadmap" />
    <SectionHeading id="roadmap-heading" text="Roadmap" />
    <p class="z-body-lg z-roadmap-section__intro">
      Four phases, in order. Phase 1 is under way — nothing here is marked done, because that
      would be the one dishonest line on this page.
    </p>

    <RoadmapTrack />
  </div>
</section>

<style>
  .z-roadmap-section__intro {
    color: var(--z-text-secondary);
    margin-block-end: var(--z-space-8);
  }
</style>
