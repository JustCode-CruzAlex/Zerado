---
/**
 * Section 13 — after-phase-4. Quietest block on the page: dashed frame,
 * no fill, no glow. Ref: design/blueprint.md §2 (§13); content/landing-copy.md §13.
 */
import SectionEyebrow from '../components/SectionEyebrow.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<section id="after-phase-4" aria-labelledby="after-phase-4-heading" class="z-section z-section--bg">
  <div class="z-container-narrow">
    <SectionEyebrow index={13} id="after-phase-4" />
    <SectionHeading
      id="after-phase-4-heading"
      text="After Phase 4"
      emphasis="— ideas, not promises"
      emphasisTone="secondary"
    />
    <div class="z-speculation-block">
      <p class="z-body">
        A few directions under discussion, none scheduled and none committed: more storefronts
        beyond the four above, deeper backlog analytics, and mood tagging that improves the more
        you use it. Nothing here has a date, and nothing here is a promise.
      </p>
    </div>
  </div>
</section>

<style>
  .z-speculation-block {
    padding: var(--z-space-6);
    border: 1px dashed var(--z-border-strong);
  }
</style>
