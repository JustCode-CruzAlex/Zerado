---
/**
 * PoweredByFlowForge — the mandatory colophon. Never redraw or substitute
 * the FlowForge mark. Styled quietly in the muted footer tone.
 * Ref: ForgePlay build brief HARD REQUIREMENT #2; design/blueprint.md §2 (§16).
 */
---

<a
  class="site-footer__powered"
  href="https://www.flowforgesoft.com"
  target="_blank"
  rel="noopener noreferrer"
>
  <img src="/flowforge-logo.svg" alt="FlowForge" width="18" height="18" loading="lazy" />
  <span>Powered by FlowForge</span>
</a>

<style>
  .site-footer__powered {
    display: inline-flex;
    align-items: center;
    gap: var(--z-space-2);
    min-block-size: 44px;
    color: var(--z-text-tertiary);
    font-size: var(--z-text-caption);
    transition: color var(--z-duration-fast) var(--z-ease-standard);
  }

  .site-footer__powered img {
    flex-shrink: 0;
    border-radius: var(--z-radius-sm);
  }

  .site-footer__powered:hover {
    color: var(--z-text-secondary);
  }
</style>
