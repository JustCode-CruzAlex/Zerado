---
/**
 * Footer — section 16, three bands inside <footer role="contentinfo">.
 * No repeated Zerado lockup (already in nav) — one mark per page, plus the
 * maker's mark. Ref: design/blueprint.md §2 (§16).
 */
import FooterLink from './FooterLink.astro';
import PoweredByFlowForge from './PoweredByFlowForge.astro';
import { hasRealCovers } from '../data/coverAssets';

const WAITLIST = 'mailto:alex@flowforgesoft.com?subject=Zerado-WaitList';
const CONTACT = 'mailto:alex@flowforgesoft.com';
const GITHUB = 'https://github.com/JustCode-CruzAlex/Zerado';

// Second half of the IGDB attribution — visible and in a static location, per
// docs/legal/igdb-image-licence-finding.md §6. It appears only when covers
// actually ship, so the page never credits a source it did not use. Plain text,
// not a link: the page's zero-external-request guarantee is load-bearing.
const realCovers = hasRealCovers();
---

<footer role="contentinfo" id="footer" class="z-footer z-section z-section--surface">
  <div class="z-container">
    <div class="z-footer__band z-footer__band--links">
      <nav class="z-footer__nav" aria-label="Footer">
        <FooterLink href={WAITLIST} label="Join the waitlist" />
        <FooterLink href={GITHUB} label="View on GitHub" rel />
      </nav>
      <p class="z-body-sm z-footer__contact">
        Contact: <a class="z-footer__contact-link" href={CONTACT}>alex@flowforgesoft.com</a>
      </p>
    </div>

    <div class="z-footer__band z-footer__band--disclosure">
      <p class="z-body-sm">
        Zerado is free software and earns no money. There is no commission on any link on this
        page, nothing here is for sale, and there is no funding ask anywhere on it. The Phase 4
        community layer will be donation-supported when it exists.
      </p>
      {realCovers && (
        <p class="z-body-sm">
          Game cover art on this page is from IGDB.com, used under the Twitch Developer Services
          Agreement. Zerado is not affiliated with IGDB, Twitch, or any game publisher, and each
          cover remains the property of its rights holder.
        </p>
      )}
    </div>

    <div class="z-footer__band z-footer__band--company">
      <p class="z-body-sm z-footer__company-line">A FlowForgeSoft product.</p>
      <PoweredByFlowForge />
    </div>
  </div>
</footer>

<style>
  .z-footer {
    padding-block-end: var(--z-space-8);
  }

  .z-footer__band {
    display: flex;
    flex-direction: column;
    gap: var(--z-space-3);
    padding-block: var(--z-space-6);
    border-block-start: 1px solid var(--z-border);
  }

  .z-footer__band:first-child {
    border-block-start: none;
  }

  .z-footer__nav {
    display: flex;
    gap: var(--z-space-6);
    flex-wrap: wrap;
  }

  .z-footer__contact-link {
    color: var(--z-text-link);
  }

  .z-footer__contact-link:hover {
    color: var(--z-text-link-hover);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .z-footer__band--links {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .z-footer__band--company {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
